{
  "name": "nivel20-character-bot",
  "version": "1.0.0",
  "description": "Discord bot for searching Nivel20 D&D characters",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && pnpm run copy:assets",
    "copy:assets": "mkdir -p dist/database && cp src/database/schema.sql dist/database/",
    "start": "node dist/index.js",
    "dev": "concurrently \"tsc -w\" \"nodemon dist/index.js\"",
    "deploy:commands": "tsc && node dist/deploy-commands.js"
  },
  "keywords": [
    "discord",
    "bot",
    "dnd",
    "nivel20",
    "character-search"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^8.2.2",
    "node-gyp": "^11.4.2",
    "nodemon": "^3.1.4",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.0.0-rc.12",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1"
  }
}
