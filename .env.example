# Discord Bot Configuration
CLIENT_ID=your_discord_client_id_here
TOKEN=your_discord_bot_token_here
GUILD_ID=your_discord_guild_id_here

# Admin Web Configuration
ADMIN_API_KEY=your_admin_api_key_here_make_it_secure
JWT_SECRET=your_jwt_secret_here_make_it_long_and_secure
SESSION_SECRET=your_session_secret_here_make_it_long_and_secure

# Environment
NODE_ENV=development
TIMEZONE=America/Argentina/Buenos_Aires

# Database (shared between services)
DB_PATH=./data/bruno-bot.db
