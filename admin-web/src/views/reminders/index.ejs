<% 
let currentRoute = 'reminders';
%>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'discord-blurple': '#5865F2',
                        'discord-green': '#3BA55C',
                        'discord-yellow': '#FAA61A',
                        'discord-red': '#ED4245',
                        'discord-orange': '#EB7590'
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.5rem;
            font-size: 0.875rem;
            font-weight: 500;
            transition: color 0.2s, background-color 0.2s;
        }
        .sidebar-item-active {
            background-color: #1e40af;
            color: white;
        }
        .sidebar-item-inactive {
            color: #dbeafe;
        }
        .sidebar-item-inactive:hover {
            background-color: #2563eb;
            color: white;
        }
        .card {
            background: white;
            border-radius: 0.5rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        }
        .card-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #e5e7eb;
        }
        .card-body {
            padding: 1.5rem;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s;
        }
        .btn-primary {
            background-color: #5865F2;
            color: white;
        }
        .btn-primary:hover {
            background-color: #4752C4;
        }
        .btn-secondary {
            background-color: #f3f4f6;
            color: #374151;
            border: 1px solid #d1d5db;
        }
        .btn-secondary:hover {
            background-color: #e5e7eb;
            color: #111827;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-weight: 500;
        }
        .badge-active {
            background-color: #d1fae5;
            color: #065f46;
        }
        .badge-inactive {
            background-color: #fee2e2;
            color: #991b1b;
        }
    </style>
</head>
<body class="bg-gray-50">
    <div class="min-h-screen flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-discord-blurple text-white">
            <div class="p-6">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center">
                        <i class="fas fa-dice text-discord-blurple text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold">Bruno Bot</h1>
                        <p class="text-xs text-blue-200">Panel de Administración</p>
                    </div>
                </div>
            </div>
            
            <nav class="mt-6">
                <a href="/admin/dashboard" class="sidebar-item sidebar-item-inactive mb-1">
                    <i class="fas fa-chart-line w-5 mr-3"></i>
                    Dashboard
                </a>

                <a href="/admin/reminders" class="sidebar-item sidebar-item-active mb-1">
                    <i class="fas fa-clock w-5 mr-3"></i>
                    Recordatorios
                </a>
                <a href="/admin/shop" class="sidebar-item sidebar-item-inactive mb-1">
                    <i class="fas fa-store w-5 mr-3"></i>
                    Tienda
                </a>

            </nav>
            
            <div class="absolute bottom-0 w-64 p-6 border-t border-blue-700">
                <form action="/auth/logout" method="POST" class="w-full">
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg transition-colors duration-200">
                        <i class="fas fa-sign-out-alt mr-2"></i>
                        Cerrar Sesión
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col">
            <!-- Top Header -->
            <header class="bg-white shadow-sm border-b border-gray-200">
                <div class="px-6 py-4 flex items-center justify-between">
                    <div>
                        <h2 class="text-2xl font-semibold text-gray-900"><%= title.replace(' - Bruno Bot Admin', '') %></h2>
                        <p class="text-sm text-gray-600">Gestiona los recordatorios programados</p>
                    </div>
                    <div class="flex items-center space-x-4">
                        <div class="text-right">
                            <p class="text-sm font-medium text-gray-900">Administrador</p>
                            <p class="text-xs text-gray-500">En línea</p>
                        </div>
                        <div class="w-10 h-10 bg-discord-green rounded-full flex items-center justify-center">
                            <i class="fas fa-user text-white"></i>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <div class="flex-1 p-6">
                <div class="space-y-6">
                    <!-- Stats Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="flex items-center">
                                    <div class="w-12 h-12 bg-discord-blurple rounded-lg flex items-center justify-center">
                                        <i class="fas fa-clock text-white text-xl"></i>
                                    </div>
                                    <div class="ml-4">
                                        <p class="text-sm font-medium text-gray-600">Total Recordatorios</p>
                                        <p class="text-2xl font-bold text-gray-900"><%= reminders.length %></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-body">
                                <div class="flex items-center">
                                    <div class="w-12 h-12 bg-discord-green rounded-lg flex items-center justify-center">
                                        <i class="fas fa-check-circle text-white text-xl"></i>
                                    </div>
                                    <div class="ml-4">
                                        <p class="text-sm font-medium text-gray-600">Activos</p>
                                        <p class="text-2xl font-bold text-gray-900">
                                            <%= reminders.filter(r => r.is_active).length %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-body">
                                <div class="flex items-center">
                                    <div class="w-12 h-12 bg-discord-yellow rounded-lg flex items-center justify-center">
                                        <i class="fas fa-server text-white text-xl"></i>
                                    </div>
                                    <div class="ml-4">
                                        <p class="text-sm font-medium text-gray-600">Servidores</p>
                                        <p class="text-2xl font-bold text-gray-900">
                                            <%= [...new Set(reminders.map(r => r.guild_name))].length %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reminders Table -->
                    <div class="card">
                        <div class="card-header flex items-center justify-between">
                            <h3 class="text-lg font-semibold text-gray-900">Todos los Recordatorios</h3>
                            <button class="btn btn-primary">
                                <i class="fas fa-plus mr-2"></i>
                                Nuevo Recordatorio
                            </button>
                        </div>
                        <div class="card-body">
                            <% if (reminders.length === 0) { %>
                                <div class="text-center py-12">
                                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <i class="fas fa-clock text-gray-400 text-2xl"></i>
                                    </div>
                                    <h3 class="text-lg font-medium text-gray-900 mb-2">No hay recordatorios</h3>
                                    <p class="text-gray-500">No se han configurado recordatorios programados.</p>
                                </div>
                            <% } else { %>
                                <div class="overflow-x-auto">
                                    <table class="min-w-full divide-y divide-gray-200">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Servidor
                                                </th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Mensaje
                                                </th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Día
                                                </th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Hora
                                                </th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Canal
                                                </th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Estado
                                                </th>
                                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Acciones
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody class="bg-white divide-y divide-gray-200">
                                            <% reminders.forEach(reminder => { %>
                                                <tr class="hover:bg-gray-50">
                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                        <div class="text-sm font-medium text-gray-900">
                                                            <%= reminder.guild_name %>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <div class="text-sm text-gray-900 max-w-xs truncate">
                                                            <%= reminder.message %>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                        <div class="text-sm text-gray-900">
                                                            <%= reminder.day_of_week %>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                        <div class="text-sm text-gray-900">
                                                            <%= reminder.time %>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                        <div class="text-sm text-gray-900">
                                                            #<%= reminder.channel_name || reminder.channel_id %>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                        <% if (reminder.is_active) { %>
                                                            <span class="badge badge-active">
                                                                <i class="fas fa-check-circle mr-1"></i>
                                                                Activo
                                                            </span>
                                                        <% } else { %>
                                                            <span class="badge badge-inactive">
                                                                <i class="fas fa-pause-circle mr-1"></i>
                                                                Inactivo
                                                            </span>
                                                        <% } %>
                                                    </td>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                                        <button class="text-discord-blurple hover:text-discord-blurple/80 mr-3">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="text-red-600 hover:text-red-800">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Simple API client for frontend interactions
        window.api = {
            request: async (url, options = {}) => {
                const response = await fetch(url, {
                    headers: {
                        'Content-Type': 'application/json',
                        ...options.headers
                    },
                    ...options
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                return response.json();
            },
            
            get: (url) => window.api.request(url),
            post: (url, data) => window.api.request(url, {
                method: 'POST',
                body: JSON.stringify(data)
            }),
            put: (url, data) => window.api.request(url, {
                method: 'PUT',
                body: JSON.stringify(data)
            }),
            delete: (url) => window.api.request(url, {
                method: 'DELETE'
            })
        };
    </script>
</body>
</html>