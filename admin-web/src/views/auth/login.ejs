<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-discord-blurple to-discord-fuchsia min-h-screen flex items-center justify-center">
    <div class="max-w-md w-full space-y-8 p-8">
        <div class="text-center">
            <div class="mx-auto w-20 h-20 bg-white rounded-2xl flex items-center justify-center shadow-lg">
                <i class="fas fa-dice text-discord-blurple text-3xl"></i>
            </div>
            <h2 class="mt-6 text-3xl font-bold text-white">Bruno Bot</h2>
            <p class="mt-2 text-sm text-blue-100">Panel de Administración</p>
        </div>
        
        <div class="bg-white rounded-2xl shadow-xl p-8">
            <form action="/auth/login" method="POST" class="space-y-6">
                <div>
                    <label for="apiKey" class="form-label">API Key</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-key text-gray-400"></i>
                        </div>
                        <input 
                            id="apiKey" 
                            name="apiKey" 
                            type="password" 
                            required 
                            class="form-input pl-10"
                            placeholder="Ingresa tu API key"
                            autocomplete="current-password"
                        >
                    </div>
                </div>

                <% if (error) { %>
                    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                        <div class="flex items-center">
                            <i class="fas fa-exclamation-circle text-red-500 mr-2"></i>
                            <span class="text-red-700 text-sm"><%= error %></span>
                        </div>
                    </div>
                <% } %>

                <div>
                    <button type="submit" class="w-full btn btn-primary">
                        <i class="fas fa-sign-in-alt mr-2"></i>
                        Iniciar Sesión
                    </button>
                </div>
            </form>
            
            <div class="mt-6 text-center">
                <p class="text-xs text-gray-500">
                    <i class="fas fa-shield-alt mr-1"></i>
                    Acceso restringido a administradores
                </p>
            </div>
        </div>
        
        <div class="text-center">
            <p class="text-xs text-blue-100">
                <i class="fas fa-info-circle mr-1"></i>
                Contacta al administrador del sistema si no tienes acceso
            </p>
        </div>
    </div>
</body>
</html>