{
  "name": "bruno-bot-admin-web",
  "version": "1.0.0",
  "description": "Panel de administración web para Bruno Bot",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run build:css && npm run copy:assets",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/main.css --minify",
    "copy:assets": "cp -r src/views dist/ && cp -r src/public dist/",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "dev": "concurrently \"tsc -w\" \"nodemon -r tsconfig-paths/register dist/server.js\" \"npm run dev:css\"",
    "dev:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/main.css --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "discord",
    "bot",
    "admin",
    "dashboard",
    "dnd",
    "bruno-bot"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  }
}
