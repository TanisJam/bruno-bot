# Admin Web Configuration
NODE_ENV=development
PORT=3000

# Database (shared with bot)
DB_PATH=/app/data/bruno-bot.db

# Authentication
ADMIN_API_KEY=your_admin_api_key_here
JWT_SECRET=your_jwt_secret_here_make_it_long_and_secure
SESSION_SECRET=your_session_secret_here_make_it_long_and_secure

# JWT Configuration
JWT_EXPIRES_IN=24h

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Timezone
TIMEZONE=America/Argentina/Buenos_Aires